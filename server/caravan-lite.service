[Unit]
Description=Caravan compact registration and leaderboard
After=network.target
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/caravan-source
Environment=CARAVAN_DATA_DIR=/var/lib/caravan-lite
ExecStart=/home/ubuntu/caravan-source/.server-venv/bin/python -m uvicorn server.caravan_api:create_app --factory --host 127.0.0.1 --port 8770 --workers 1 --loop asyncio --http h11 --ws none --limit-concurrency 16 --backlog 32 --timeout-keep-alive 5 --no-access-log --no-proxy-headers --log-level warning
StateDirectory=caravan-lite
StateDirectoryMode=0700
UMask=0077
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
MemoryMax=128M
CPUQuota=25%
TasksMax=32
Nice=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
LogRateLimitIntervalSec=60
LogRateLimitBurst=10

[Install]
WantedBy=multi-user.target
